{
  "name": "outpassed",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @outpassed/api dev",
    "dev:mobile": "pnpm --filter @outpassed/mobile start",
    "build": "pnpm --filter @outpassed/api build",
    "test": "pnpm --filter @outpassed/api test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @outpassed/api db:generate",
    "db:migrate": "pnpm --filter @outpassed/api db:migrate"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
