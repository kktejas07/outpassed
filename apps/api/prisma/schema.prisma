generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  WARDEN
  GUARD
  ADMIN
}

enum OutpassType {
  LOCAL
  HOME
  MEDICAL
  EMERGENCY
}

enum OutpassStatus {
  PENDING_PARENT
  PENDING_WARDEN
  APPROVED
  REJECTED
  CANCELLED
  OUT
  RETURNED
}

enum ApprovalStep {
  PARENT
  WARDEN
}

enum Decision {
  APPROVE
  REJECT
}

enum GateDirection {
  EXIT
  ENTRY
}

enum GateMethod {
  QR
  MANUAL
}

enum VisitStatus {
  PENDING_HOST
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
}

enum VisitorType {
  GUEST
  PARENT
  RECRUITER
  VENDOR
  EVENT
  ALUMNI
  DELIVERY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  student         StudentProfile?
  wards           Guardianship[]  @relation("ParentGuardianships")
  guardians       Guardianship[]  @relation("StudentGuardianships")
  outpasses       Outpass[]       @relation("StudentOutpasses")
  approvals       Approval[]
  hostedVisits    Visit[]         @relation("HostedVisits")
  registeredVisits Visit[]        @relation("RegisteredVisits")
  gateEvents      GateEvent[]
  notifications   Notification[]
  pushTokens      PushToken[]
  passwordResets  PasswordReset[]
  extensionDecisions OutpassExtension[] @relation("ExtensionDecisions")
  parcels         Parcel[]        @relation("StudentParcels")
  loggedParcels   Parcel[]        @relation("LoggedParcels")
  handedParcels   Parcel[]        @relation("HandedParcels")
  sosRaised       SosAlert[]      @relation("SosRaised")
  sosAcknowledged SosAlert[]      @relation("SosAcknowledged")
  sosResolved     SosAlert[]      @relation("SosResolved")
  notices         Notice[]
  noticeReads     NoticeRead[]

  @@index([role])
  @@map("users")
}

model StudentProfile {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo      String?   @unique
  hostel      String?
  room        String?
  dateOfBirth DateTime? @db.Date

  @@map("student_profiles")
}

/// Links a parent/guardian account to a student. Priority 1 is asked first.
model Guardianship {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation("StudentGuardianships", fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User     @relation("ParentGuardianships", fields: [parentId], references: [id], onDelete: Cascade)
  relation  String   @default("Parent")
  priority  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("guardianships")
}

model Outpass {
  id          String        @id @default(uuid())
  studentId   String
  student     User          @relation("StudentOutpasses", fields: [studentId], references: [id], onDelete: Cascade)
  type        OutpassType
  destination String
  reason      String
  leaveAt     DateTime
  returnBy    DateTime
  status      OutpassStatus
  exitedAt    DateTime?
  returnedAt  DateTime?
  /// Set once the overdue alert has gone out, so it's sent only once.
  overdueAlertedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  approvals  Approval[]
  gateEvents GateEvent[]
  extensions OutpassExtension[]

  @@index([studentId, status])
  @@index([status, returnBy])
  @@map("outpasses")
}

model Approval {
  id         String       @id @default(uuid())
  outpassId  String
  outpass    Outpass      @relation(fields: [outpassId], references: [id], onDelete: Cascade)
  step       ApprovalStep
  decision   Decision
  approverId String
  approver   User         @relation(fields: [approverId], references: [id])
  /// True when a warden decided a parent step (parent unreachable).
  override   Boolean      @default(false)
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([outpassId])
  @@map("approvals")
}

model Visit {
  id             String      @id @default(uuid())
  visitorName    String
  visitorPhone   String
  visitorType    VisitorType @default(GUEST)
  purpose        String
  status         VisitStatus
  walkIn         Boolean     @default(false)
  validFrom      DateTime
  validTo        DateTime
  hostId         String
  host           User        @relation("HostedVisits", fields: [hostId], references: [id], onDelete: Cascade)
  registeredById String
  registeredBy   User        @relation("RegisteredVisits", fields: [registeredById], references: [id])
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  /// 6-digit entry code the visitor can read out at the gate.
  code           String
  /// Unguessable id for the public pass link sent to the visitor.
  passToken      String      @unique
  createdAt      DateTime    @default(now())

  gateEvents GateEvent[]

  @@index([hostId, status])
  @@index([status])
  @@index([code])
  @@map("visits")
}

model GateEvent {
  /// Client-generated so offline retries are idempotent.
  id         String        @id
  direction  GateDirection
  gate       String
  method     GateMethod    @default(QR)
  accepted   Boolean
  personName String
  note       String?
  outpassId  String?
  outpass    Outpass?      @relation(fields: [outpassId], references: [id], onDelete: SetNull)
  visitId    String?
  visit      Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  guardId    String
  guard      User          @relation(fields: [guardId], references: [id])
  deviceTime DateTime?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@map("gate_events")
}

/// In-app inbox entry; also sent as a phone push when the user has a device registered.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  /// Where tapping it should go, e.g. { "outpassId": "..." }.
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Expo push token for one installed app.
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

/// Emailed 6-digit code for resetting a password. Only the hash is stored.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_resets")
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A student's request to come back later than the approved return time.
model OutpassExtension {
  id                String          @id @default(uuid())
  outpassId         String
  outpass           Outpass         @relation(fields: [outpassId], references: [id], onDelete: Cascade)
  previousReturnBy  DateTime
  requestedReturnBy DateTime
  reason            String
  status            ExtensionStatus @default(PENDING)
  decidedById       String?
  decidedBy         User?           @relation("ExtensionDecisions", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime        @default(now())

  @@index([outpassId, status])
  @@index([status])
  @@map("outpass_extensions")
}

enum ParcelStatus {
  AT_GATE
  COLLECTED
  RETURNED
}

/// A delivery left at the gate for a student, handed over against a code.
model Parcel {
  id            String       @id @default(uuid())
  studentId     String
  student       User         @relation("StudentParcels", fields: [studentId], references: [id], onDelete: Cascade)
  carrier       String
  note          String?
  /// 4-digit code the student shows to collect it.
  code          String
  status        ParcelStatus @default(AT_GATE)
  loggedById    String
  loggedBy      User         @relation("LoggedParcels", fields: [loggedById], references: [id])
  handedById    String?
  handedBy      User?        @relation("HandedParcels", fields: [handedById], references: [id])
  collectedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("parcels")
}

enum SosKind {
  MEDICAL
  SAFETY
  OTHER
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// An emergency raised from the app; wardens and guards are alerted at once.
model SosAlert {
  id               String    @id @default(uuid())
  raisedById       String
  raisedBy         User      @relation("SosRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  kind             SosKind
  note             String?
  status           SosStatus @default(OPEN)
  acknowledgedById String?
  acknowledgedBy   User?     @relation("SosAcknowledged", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedBy       User?     @relation("SosResolved", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([raisedById])
  @@map("sos_alerts")
}

enum NoticeAudience {
  STUDENTS
  PARENTS
  EVERYONE
}

model Notice {
  id        String         @id @default(uuid())
  title     String
  body      String
  audience  NoticeAudience @default(STUDENTS)
  pinned    Boolean        @default(false)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  reads NoticeRead[]

  @@index([createdAt])
  @@map("notices")
}

model NoticeRead {
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@id([noticeId, userId])
  @@map("notice_reads")
}
