# Copy to apps/api/.env  (Prisma CLI and the API both read it from this directory)
# Local Postgres from docker-compose, or your Dokploy Postgres connection string.
DATABASE_URL=postgresql://outpassed:outpassed@localhost:5432/outpassed
# Must be at least 16 characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
# Access tokens are short; the app renews them with a refresh token (one use each).
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PORT=3000
NODE_ENV=development
# "*" allows all origins; comma-separate to restrict.
CORS_ORIGIN=*
# Signs gate QR codes. Falls back to JWT_SECRET when unset; set its own value in production.
# QR_SECRET=another-long-random-string
# How long a student's gate QR stays valid (seconds). The app refreshes it before then.
QR_TTL_SECONDS=45
# Students aged 18+: "approve" still asks the parent; "notify_only" skips straight to the warden.
ADULT_PARENT_MODE=approve
# Visitor pass links point at ${PUBLIC_WEB_URL}/app/pass/<token>
PUBLIC_WEB_URL=https://outpassed.studentalumni.ai
# Shown on the visitor's pass
CAMPUS_NAME=Main Campus
CAMPUS_ADDRESS=
# Phone push through Expo (set to false to keep alerts in-app only)
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=   # only if "Enhanced push security" is on for the Expo project
# Email for password reset codes. Without it, development prints codes to the console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Outpass <no-reply@outpassed.studentalumni.ai>
# First-time setup (the /setup screen) needs this key in production. Remove it once setup is done.
# SETUP_TOKEN=a-long-random-one-time-key
# --- WhatsApp: sign-in codes, parent/staff alerts, visitor passes, welcome messages ---
#   webhook   POSTs {"to":"+91...","phone":"91...","text":"...","kind":"OTP|STUDENT_LEFT|VISITOR_PASS|...","code":"123456"}
#             to WHATSAPP_URL with "Authorization: Bearer WHATSAPP_TOKEN" (your own server)
#   evolution Evolution API: WHATSAPP_URL=https://wa.example.com, WHATSAPP_TOKEN=apikey, WHATSAPP_INSTANCE=instance
#   waha      WAHA: WHATSAPP_URL=https://waha.example.com, WHATSAPP_TOKEN=X-Api-Key, WHATSAPP_INSTANCE=session
#   cloud     Meta WhatsApp Cloud API: WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_TOKEN, approved templates below
#   off       development: messages are printed to the console
WHATSAPP_MODE=off
# WHATSAPP_URL=https://wa.yourserver.com/send
# WHATSAPP_TOKEN=
# WHATSAPP_INSTANCE=default
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=outpass_otp          # cloud: authentication template with the code
# WHATSAPP_ALERT_TEMPLATE=outpass_alert      # cloud: utility template, {{1}} title {{2}} message
# WHATSAPP_TEMPLATE_LANG=en
# Which alerts also go to WhatsApp: all, none, or a list such as OUTPASS_NEEDS_PARENT,STUDENT_LEFT,STUDENT_RETURNED,STUDENT_OVERDUE,SOS_RAISED
WHATSAPP_ALERTS=all
# Sign-in codes go by whatsapp (default) or sms
OTP_CHANNEL=whatsapp
# SMS fallback (only when OTP_CHANNEL=sms): console (development only), msg91 or twilio.
SMS_PROVIDER=console
# MSG91 (India; needs a DLT-approved OTP template with an "otp" variable)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1555...
# Country code assumed for 10-digit numbers
DEFAULT_COUNTRY_CODE=91
# Per-address rate limits on sign-in, codes and the gate. Keep on in production.
RATE_LIMIT=true
