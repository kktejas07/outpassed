# Copy to apps/api/.env  (Prisma CLI and the API both read it from this directory)
# Local Postgres from docker-compose, or your Dokploy Postgres connection string.
DATABASE_URL=postgresql://outpassed:outpassed@localhost:5432/outpassed
# Must be at least 16 characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
# "*" allows all origins; comma-separate to restrict.
CORS_ORIGIN=*
