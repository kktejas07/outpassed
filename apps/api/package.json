{
  "name": "@outpassed/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "10.3.0",
    "@outpassed/shared": "workspace:*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.8.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
