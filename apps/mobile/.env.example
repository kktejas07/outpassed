# Copy to .env (Expo reads .env from the app directory).
# Only EXPO_PUBLIC_* variables are exposed to the app bundle.
#
# Local development:
#   iOS simulator:    http://localhost:3000
#   Android emulator: http://10.0.2.2:3000
#   Physical device:  http://<your-LAN-IP>:3000
#
# Production (set this in eas.json / the EAS environment for release builds):
EXPO_PUBLIC_API_URL=http://localhost:3000
