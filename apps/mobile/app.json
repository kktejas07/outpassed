{
  "expo": {
    "name": "Outpass",
    "slug": "outpassed",
    "scheme": "outpassed",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4338CA"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Outpass uses the camera to scan gate passes and to take your profile photo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Outpass uses your photos to set your profile picture, which guards check at the gate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.studentalumni.outpassed",
      "infoPlist": {
        "NSCameraUsageDescription": "Outpass uses the camera to scan gate passes."
      }
    },
    "android": {
      "package": "ai.studentalumni.outpassed",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14B8A6"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Outpass",
      "shortName": "Outpass",
      "themeColor": "#1E1B4B",
      "backgroundColor": "#F5F6FB"
    },
    "icon": "./assets/icon.png"
  }
}
