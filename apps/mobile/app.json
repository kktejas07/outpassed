{
  "expo": {
    "name": "Arvio",
    "slug": "outpassed",
    "scheme": "outpassed",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Arvio uses the camera to scan gate passes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.studentalumni.outpassed"
    },
    "android": {
      "package": "ai.studentalumni.outpassed",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#FAF9FE"
    }
  }
}
